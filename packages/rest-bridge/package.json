{
  "name": "ascii-magic-art-rest",
  "version": "0.1.0",
  "description": "The 240 pieces of ascii.rest as ascii-magic-art pieces, and ascii.rest's animated SVGs, banners and logo glyphs for ascii-magic-art pieces.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": { "types": "./src/index.d.ts", "default": "./dist/index.js" },
    "./bridge": { "types": "./src/index.d.ts", "default": "./src/bridge.js" },
    "./package.json": "./package.json"
  },
  "files": ["dist", "src", "README.md"],
  "scripts": {
    "build": "node scripts/build.mjs",
    "prepare": "node scripts/build.mjs",
    "validate": "node scripts/validate-rest.mjs",
    "test": "node --test \"test/*.test.mjs\""
  },
  "peerDependencies": {
    "ascii-magic-art": ">=1.0.2"
  }
}
